# =========================================================
# Redmi AC2100 稳定高效版 .config
# 目标：校园网认证 + UA2F + 极简 LuCI + 不堆插件
# 机型：Xiaomi Redmi Router AC2100 / RM2100
# 架构：ramips / mt7621
# =========================================================

# =========================================================
# 1. 目标机型：红米 AC2100
# =========================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y

# =========================================================
# 2. 基础系统与极简 LuCI
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# LuCI 兼容层，部分第三方 LuCI 插件可能需要
CONFIG_PACKAGE_luci-compat=y

# =========================================================
# 3. 核心需求：校园网认证 + UA2F
# =========================================================
CONFIG_PACKAGE_mentohust=y
CONFIG_PACKAGE_luci-app-mentohust=y

CONFIG_PACKAGE_ua2f=y
CONFIG_PACKAGE_luci-app-ua2f=y

# =========================================================
# 4. UA2F / 防检测相关底层依赖
# =========================================================

# nftables 相关依赖
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_nftables-json=y

# iptables 兼容依赖
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-nft=y

# 常用网络基础依赖，避免第三方插件编译后运行缺库
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y

# =========================================================
# 5. 稳定优先：不启用激进加速插件
# =========================================================

# 不建议为了“高效”强行开 turboacc / sfe / fullcone
# 校园网认证环境下，激进加速容易导致认证、TTL、UA2F 行为异常
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-flowoffload is not set
# CONFIG_PACKAGE_luci-app-sfe is not set

# =========================================================
# 6. 去肥增稳：不编译常见重型插件
# =========================================================

# 网络服务类
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set

# 代理/娱乐/大体积插件
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-unblockmusic is not set
# CONFIG_PACKAGE_luci-app-uugamebooster is not set

# 主题类，只保留 bootstrap
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-design is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-netgear is not set

# =========================================================
# 7. USB：红米 AC2100 无 USB 口，可继续关闭
# =========================================================
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set

# =========================================================
# 8. IPv6：默认不主动删除
# =========================================================
# 说明：
# 校园网环境有些地方会用到 IPv6。
# 为了稳定，不建议像小内存机器那样暴力删除 IPv6。
# 如果你确定校园网完全不用 IPv6，再额外裁剪。
